{
  "expo": {
    "name": "iMessage",
    "slug": "imessage",
    "scheme": "imessage",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.imessage.app"
    },
    "android": {
      "package": "com.imessage.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "plugins": [
      "./plugins/withCrashReporter.js",
      "expo-secure-store",
      [
        "expo-av",
        {
          "microphonePermission": "Allow iMessage to record voice notes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow iMessage to access your photos to share images."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#007AFF"
        }
      ]
    ],
    "extra": {
      "clerkPublishableKey": "pk_test_bXVzaWNhbC1kb3J5LTI2MDQuY2xlcmsuYWNjb3VudHMuZGV2JA",
      "apiUrl": "https://imessage-fwxv.onrender.com"
    }
  }
}
