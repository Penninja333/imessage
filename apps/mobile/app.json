{
  "expo": {
    "name": "iMessage",
    "slug": "imessage",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "imessage",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.imessage.app",
      "infoPlist": {
        "NSCameraUsageDescription": "iMessage needs camera access to send photos.",
        "NSPhotoLibraryUsageDescription": "iMessage needs photo library access to send photos."
      }
    },
    "android": {
      "package": "com.imessage.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow iMessage to access your Face ID for quick sign-in."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "iMessage needs photo library access to send photos.",
          "cameraPermission": "iMessage needs camera access to send photos."
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "clerkPublishableKey": "pk_test_YmFsYW5jZWQtYnVnLTMzLmNsZXJrLmFjY291bnRzLmRldiQ",
      "eas": {
        "projectId": "0a7d858e-6991-44c3-88f9-d67a24d87edd"
      }
    },
    "owner": "fin45309"
  }
}
